# Firebase / Cloud Run
FIREBASE_PROJECT_ID=inteliux-os
# On Cloud Run, prefer the attached service account and Application Default Credentials.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Kimi provider secret: NEVER commit the real value.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=
KIMI_MAX_CONTEXT_SIZE=128000

# Optional: otherwise generated by `kimi web` and read from KIMI_CODE_HOME/server.token
KIMI_SERVER_TOKEN=
KIMI_CODE_HOME=/root/.kimi-code
KIMI_PORT=58627
